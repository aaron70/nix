{...}: {
  flake.dotfiles.pi.default = {pkgs, ...}: let
    # Loader stub for a saved extension. It imports the editable copy from
    # ~/.pi/agent/dev-extensions/<name>' when that exists, otherwise the
    # read-only nix store copy. Generated; do not edit.
    stubText = name: src: ''
      // Generated by modules/dotfiles/pi/pi.nix. Do not edit.
      import { existsSync, statSync } from "node:fs";
      import { homedir } from "node:os";
      import { join } from "node:path";

      const NAME = "${name}";
      const ORIGINAL = "${src}";
      const AGENT_DIR = process.env.PI_CODING_AGENT_DIR ?? join(homedir(), ".pi", "agent");
      const EDITABLE = join(AGENT_DIR, "dev-extensions", NAME + "'");

      export default async function (pi: any) {
        const dir = existsSync(EDITABLE) ? EDITABLE : ORIGINAL;
        const entry = statSync(dir).isDirectory() ? join(dir, "index.ts") : dir;
        const mod = await import(entry + "?v=" + Date.now());
        return mod.default(pi);
      }
    '';

    # settings.extensions entry for a saved extension: a store directory
    # containing <name>/index.ts, which is the stub above.
    mkStub = name: src: let
      index = pkgs.writeText "index.ts" (stubText name src);
      dir = pkgs.runCommand "pi-ext-${name}" {} ''
        mkdir -p $out/${name}
        cp ${index} $out/${name}/index.ts
      '';
    in "${dir}/${name}";
  in {
    defaultProvider = "opencode-go";
    defaultModel = "claude-haiku-5-5";
    extensions = [
      (mkStub "extension-manager" ./agent/extensions/extension-manager)
      # BEGIN ext-manager (managed by /ext save; keep these markers)
      # END ext-manager
    ];
  };
}
